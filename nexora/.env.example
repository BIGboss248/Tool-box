# =============================================================================
# Nexora Panel Configuration Environment File
# =============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# Or run 'make setup-all' for a guided interactive setup.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Panel Service Configuration
# -----------------------------------------------------------------------------
NEXORA_IMAGE=ghcr.io/nexora-vpn/panel:latest
# Published port on the host (Default: 2095)
NEXORA_PORT=2095
# Host IP binding (0.0.0.0 for public access, 127.0.0.1 if behind reverse proxy only)
NEXORA_BIND_IP=0.0.0.0

# Host machine-id path to tie licensing HWID to the physical/virtual host.
# Leave default (/etc/machine-id) on Linux hosts.
MACHINE_ID_PATH=/etc/machine-id

# -----------------------------------------------------------------------------
# 2. Docker Compose Active Profiles
# -----------------------------------------------------------------------------
# Comma-separated list of enabled services:
#   - (empty)     : Standalone panel with built-in SQLite
#   - postgres    : Enables PostgreSQL 17 database container
#   - node        : Enables local node container on same server
#   - monitoring  : Enables Prometheus and Grafana monitoring containers
# Example for full stack: COMPOSE_PROFILES=postgres,monitoring
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# 3. Database Engine Settings
# -----------------------------------------------------------------------------
# Database driver: 'sqlite' or 'postgres'
NEXORA_DB_DRIVER=sqlite

# Database connection DSN:
# For SQLite (default):
NEXORA_DB_DSN=/app/db/nexora.db
# For PostgreSQL (uncomment and configure if NEXORA_DB_DRIVER=postgres):
# NEXORA_DB_DSN=host=postgres port=5432 user=nexora password=change-me dbname=nexora sslmode=disable

# PostgreSQL container credentials (used if COMPOSE_PROFILES includes 'postgres')
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora
NEXORA_DB_MAX_OPEN_CONNS=25

# -----------------------------------------------------------------------------
# 4. Same-Server Node Settings (Optional, Testing/Lab Deployments)
# -----------------------------------------------------------------------------
# Enabled when COMPOSE_PROFILES contains 'node'
NEXORA_NODE_IMAGE=ghcr.io/nexora-vpn/node:latest
NEXORA_NODE_PORT=62050

# -----------------------------------------------------------------------------
# 5. Traefik Reverse Proxy Integration
# -----------------------------------------------------------------------------
# Enable routing through Traefik proxy (set to 'true' to activate router labels)
TRAEFIK_ENABLED=false
NEXORA_DOMAIN=nexora.example.com
# Traefik certificate resolver: 'myresolver' (HTTP-01) or 'cloudflare_resolver' (DNS-01)
TRAEFIK_CERTRESOLVER=myresolver
# Shared Docker network where Traefik lives
DOCKER_NETWORK=my_network

# -----------------------------------------------------------------------------
# 6. Prometheus & Grafana Monitoring
# -----------------------------------------------------------------------------
# Enabled when COMPOSE_PROFILES contains 'monitoring'
PROMETHEUS_RETENTION=365d
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_PORT=3000
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:3000

# Route Grafana through Traefik (optional)
GRAFANA_TRAEFIK_ENABLED=false
GRAFANA_DOMAIN=grafana.example.com

