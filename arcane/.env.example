# ==============================================================================
# Arcane Environment Configuration (.env.example)
# Copy this file to .env before deploying: cp .env.example .env
# The Makefile also creates it automatically (make init-env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container image, port & network
# ------------------------------------------------------------------------------
ARCANE_IMAGE=ghcr.io/getarcaneapp/manager:latest
ARCANE_CONTAINER_NAME=arcane
# Shared Docker network created by the Traefik stack
DOCKER_NETWORK=my_network
# Host bind for direct UI access. Keep loopback when Traefik fronts Arcane.
ARCANE_BIND=127.0.0.1
ARCANE_PORT=3552

# ------------------------------------------------------------------------------
# 2. Public URL & Traefik routing
# ------------------------------------------------------------------------------
# Public hostname routed by Traefik (no scheme, no port)
ARCANE_DOMAIN=arcane.example.com
# Exact URL users open; must match ARCANE_DOMAIN over https
ARCANE_APP_URL=https://arcane.example.com
# Traefik entrypoint and certificate resolver
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver
# Traefik terminates TLS; Arcane serves plain HTTP + h2c on 3552 internally.
# Keep false so remote-agent gRPC tunnels can use h2c.
ARCANE_TLS_ENABLED=false
# Comma-separated middleware chain for the web router.
# When the Traefik CrowdSec stack is enabled, prepend it:
#   ARCANE_MIDDLEWARES=crowdsec-bouncer,arcane-compress,arcane-headers
ARCANE_MIDDLEWARES=arcane-compress,arcane-headers
TRAEFIK_ENABLE=true

# ------------------------------------------------------------------------------
# 3. Security
# ------------------------------------------------------------------------------
# Required. Generate with: make setup-secret
# (docker run --rm ghcr.io/getarcaneapp/manager:latest /app/arcane generate secret)
ARCANE_ENCRYPTION_KEY=
# CIDR range Traefik connects from. Set automatically by: make setup-proxies
ARCANE_TRUSTED_PROXIES=172.18.0.0/16

# ------------------------------------------------------------------------------
# 4. Bind mounts (no named volumes)
# ------------------------------------------------------------------------------
# Host paths, relative to this directory unless absolute.
ARCANE_DATA_DIR=./data
ARCANE_PROJECTS_DIR=./projects
ARCANE_BUILDS_DIR=./builds
ARCANE_BACKUPS_DIR=./backups
# Container path the projects folder is mounted at. Keep this in sync with the
# /opt/docker bind mount in docker-compose.yml.
ARCANE_PROJECTS_DIRECTORY=/opt/docker

# ------------------------------------------------------------------------------
# 5. Runtime identity & timezone
# ------------------------------------------------------------------------------
# Host UID/GID for files Arcane creates (defaults to 65532:65532 if omitted)
PUID=1000
PGID=1000
# IANA timezone, used by scheduled jobs (image updates, scans, GitOps sync)
TZ=UTC

# ------------------------------------------------------------------------------
# 6. Optional: remote agents
# ------------------------------------------------------------------------------
# Agent mTLS mode for agents enrolling with this Manager: disabled, optional, required.
# "required" also needs Traefik to request client certificates on the gRPC route.
# ARCANE_AGENT_MTLS_MODE=disabled

# ------------------------------------------------------------------------------
# 7. Optional: first-run admin account (only read on an empty database)
# ------------------------------------------------------------------------------
# ARCANE_DEFAULT_ADMIN_USERNAME=arcane
# ARCANE_DEFAULT_ADMIN_PASSWORD=
# ARCANE_DEFAULT_ADMIN_PASSWORD_FILE=/run/secrets/arcane_admin_password

# ------------------------------------------------------------------------------
# 8. Optional: external Postgres instead of the bundled SQLite database
# ------------------------------------------------------------------------------
# ARCANE_DATABASE_URL=postgres://user:password@postgres:5432/arcane
