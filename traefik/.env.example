# ==============================================================================
# Traefik Environment Configuration (.env.example)
# Copy this file to .env before starting Traefik: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Traefik Container Image & Logging
# ------------------------------------------------------------------------------
TRAEFIK_IMAGE=traefik:latest
# Log level: DEBUG, INFO, WARN, ERROR, FATAL, PANIC
TRAEFIK_LOG_LEVEL=INFO
# Access log format: common or json
TRAEFIK_ACCESS_LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 2. ACME / Let's Encrypt Email
# ------------------------------------------------------------------------------
# Email address used for Let's Encrypt certificate registration and notifications
ACME_EMAIL=

# ------------------------------------------------------------------------------
# 3. Cloudflare DNS-01 Challenge (Optional / Wildcard TLS)
# ------------------------------------------------------------------------------
# If using the 'cloudflare_resolver' for DNS-01 challenges (required for wildcard certs):
# Create a scoped API Token at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone.Zone (Read), Zone.DNS (Edit)
CF_API_EMAIL=
CF_DNS_API_TOKEN=
CF_ZONE_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Traefik Dashboard & API Exposure
# ------------------------------------------------------------------------------
# Enable or disable Traefik Docker labels for exposing the dashboard
TRAEFIK_DASHBOARD_ENABLE=true

# Domain under which the Traefik dashboard will be accessible (e.g. traefik.example.com)
TRAEFIK_DASHBOARD_DOMAIN=

# Certificate resolver to use for Dashboard HTTPS router:
# Options: 'myresolver' (HTTP-01 challenge) or 'cloudflare_resolver' (DNS-01 challenge)
TRAEFIK_DASHBOARD_CERTRESOLVER=myresolver

# Basic Auth credentials for dashboard protection.
# Format: username:hashed_password
# Generate hash using: htpasswd -nb user yourpassword
# IMPORTANT: In .env or docker-compose, dollar signs '$' in hashes must be doubled ('$$').
TRAEFIK_BASIC_AUTH_USERS=

# ------------------------------------------------------------------------------
# 5. Metrics & Networking
# ------------------------------------------------------------------------------
# Docker network name shared with other containers
DOCKER_NETWORK=my_network
# Optional metrics path suffix/customization if monitored externally
PROM_METRICS_PATH=

