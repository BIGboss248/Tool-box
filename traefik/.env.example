# ==============================================================================
# Traefik Environment Configuration (.env.example)
# Copy this file to .env before starting Traefik: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Traefik Container Image & Logging
# ------------------------------------------------------------------------------
TRAEFIK_IMAGE=traefik:latest
# Log level: DEBUG, INFO, WARN, ERROR, FATAL, PANIC
TRAEFIK_LOG_LEVEL=INFO
# Access log format: common or json
TRAEFIK_ACCESS_LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 2. ACME / Let's Encrypt Email
# ------------------------------------------------------------------------------
# Email address used for Let's Encrypt certificate registration and notifications
ACME_EMAIL=

# ------------------------------------------------------------------------------
# 3. Cloudflare DNS-01 Challenge (Optional / Wildcard TLS)
# ------------------------------------------------------------------------------
# If using the 'cloudflare_resolver' for DNS-01 challenges (required for wildcard certs):
# Create a scoped API Token at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone.Zone (Read), Zone.DNS (Edit)
CF_API_EMAIL=
CF_DNS_API_TOKEN=
CF_ZONE_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Traefik Dashboard & API Exposure
# ------------------------------------------------------------------------------
# Enable or disable Traefik Docker labels for exposing the dashboard
TRAEFIK_DASHBOARD_ENABLE=true

# Domain under which the Traefik dashboard will be accessible (e.g. traefik.example.com)
TRAEFIK_DASHBOARD_DOMAIN=

# Certificate resolver to use for Dashboard HTTPS router:
# Options: 'myresolver' (HTTP-01 challenge) or 'cloudflare_resolver' (DNS-01 challenge)
TRAEFIK_DASHBOARD_CERTRESOLVER=myresolver

# Basic Auth credentials for dashboard protection.
# Format: username:hashed_password
# Generate hash using: htpasswd -nb user yourpassword
# IMPORTANT: In .env or docker-compose, dollar signs '$' in hashes must be doubled ('$$').
TRAEFIK_BASIC_AUTH_USERS=

# ------------------------------------------------------------------------------
# 5. Metrics & Networking
# ------------------------------------------------------------------------------
# Docker network name shared with other containers
DOCKER_NETWORK=my_network
# Optional metrics path suffix/customization if monitored externally
PROM_METRICS_PATH=

# ------------------------------------------------------------------------------
# 6. CrowdSec Intrusion Prevention, Bouncer & Captcha Remediation
# ------------------------------------------------------------------------------
# Enable or disable CrowdSec protection (true / false)
CROWDSEC_ENABLED=false
# Active Docker Compose profile ('crowdsec' when enabled, blank when disabled)
COMPOSE_PROFILES=
# CrowdSec Docker Image
CROWDSEC_IMAGE=crowdsecurity/crowdsec:latest
# CrowdSec Traefik Plugin Version
CROWDSEC_BOUNCER_VERSION=v1.7.1
# CrowdSec Bouncer Operating Mode (stream, live, none, alone, appsec)
CROWDSEC_MODE=stream
# Pre-shared API Key for Traefik Bouncer (configured via 'make setup-crowdsec')
CROWDSEC_BOUNCER_KEY=

# Captcha Remediation Configuration (configured via 'make setup-captcha' or 'make setup-crowdsec')
# Supported providers: turnstile, hcaptcha, recaptcha (leave blank to disable captcha and use ban only)
CROWDSEC_CAPTCHA_PROVIDER=
# Site Key from your Captcha provider (Cloudflare Turnstile / hCaptcha / Google reCAPTCHA v2)
CROWDSEC_CAPTCHA_SITE_KEY=
# Secret Key from your Captcha provider
CROWDSEC_CAPTCHA_SECRET_KEY=
# Grace period in seconds before a solved captcha expires if decision is still active (default: 1800 = 30m)
CROWDSEC_CAPTCHA_GRACE_PERIOD=1800

# ------------------------------------------------------------------------------
# 7. OpenTelemetry Distributed Tracing (Optional)
# ------------------------------------------------------------------------------
# Enable or disable Traefik OpenTelemetry tracing (true / false, configured via 'make setup-tracing')
TRACING_ENABLED=false
# Service name reported in OpenTelemetry spans
TRAEFIK_TRACING_SERVICE_NAME=traefik
# Proportion of requests to trace (0.0 to 1.0, ParentBased TraceIDRatioBased sampling)
TRAEFIK_TRACING_SAMPLE_RATE=1.0
# Trace internal Traefik resources like ping@internal (true / false)
TRAEFIK_TRACING_ADD_INTERNALS=false
# OTLP HTTP Collector endpoint URL (default uses the built-in Jaeger container on my_network)
TRAEFIK_TRACING_OTLP_HTTP_ENDPOINT=http://jaeger:4318/v1/traces
# Jaeger All-in-One Docker Image (used when 'tracing' profile is enabled)
JAEGER_IMAGE=jaegertracing/all-in-one:latest
# Host IP to bind Jaeger UI port 16686 (127.0.0.1 for local/SSH tunnel access, 0.0.0.0 for all interfaces)
JAEGER_UI_BIND=127.0.0.1
