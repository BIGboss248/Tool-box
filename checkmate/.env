# Traefik & Routing Configuration
DOMAIN=checkmate.example.com
CERT_RESOLVER=myresolver

# Application Environment Variables
JWT_SECRET=my_secret_change_me
REDIS_URL=redis://redis:6379
DB_CONNECTION_STRING=mongodb://mongodb_checkmate:27017/uptime_db

# Interpolated App URLs
UPTIME_APP_API_BASE_URL=https://${DOMAIN}/api/v1
UPTIME_APP_CLIENT_HOST=https://${DOMAIN}
CLIENT_HOST=https://${DOMAIN}
