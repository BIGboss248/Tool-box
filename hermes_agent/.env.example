# ==============================================================================
# Hermes Agent — environment for the VPS deploy
# Copy to .env and fill in:  cp .env.example .env
# ==============================================================================

# Timezone used by Hermes timestamps and cron jobs
TZ=Asia/Tehran

# ------------------------------------------------------------------------------
# Web access (Traefik)
# ------------------------------------------------------------------------------
# Public hostname for the dashboard. Point a DNS A/AAAA record at this VPS.
# Left empty so `make setup` asks; nothing works without it.
DOMAIN=

# Traefik certificate resolver name. Left empty so `make setup` lists the
# resolvers it finds in ../traefik/docker-compose.yml; unset means the compose
# file falls back to cloudflare_resolver (DNS-01).
CERT_RESOLVER=

# Dashboard login. The dashboard refuses to start on a public address without it.
# No default username: `make setup` asks for both.
# A literal $ in either value must be written as $$ (Docker Compose expands it).
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
# Signing key for login sessions. Generate once and keep it, or everyone is
# signed out on every restart:  openssl rand -base64 32
HERMES_DASHBOARD_SECRET=

# ------------------------------------------------------------------------------
# Model provider: OpenCode Go subscription
# ------------------------------------------------------------------------------
# API key from https://opencode.ai/auth (Console -> Go -> API key).
# OpenCode Go is key-based; no OAuth flow exists. `make login` can also collect it.
OPENCODE_GO_API_KEY=

# ------------------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID from @userinfobot. Without this the bot ignores
# every sender, which is what keeps strangers out.
TELEGRAM_ALLOWED_USERS=
