# ==============================================================================
# Hermes Agent Environment Configuration
# ==============================================================================

# Timezone & Ports
TZ=UTC
HERMES_PORT=8642

# ------------------------------------------------------------------------------
# 1. LLM Model Providers (Provide at least one)
# ------------------------------------------------------------------------------
# Free Tier Recommended for Home Assistant (Ultra-fast inference):
GROQ_API_KEY=

# OpenRouter (Supports free models with ':free' suffix like llama-3.3-70b-instruct:free):
OPENROUTER_API_KEY=

# Nous Portal (Official hosted provider with free tier and 200+ models):
NOUS_API_KEY=

# Commercial Providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Remote Messaging Gateway (Chat with Hermes from your phone)
# ------------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of your Telegram numeric user IDs for security pairing
TELEGRAM_ALLOWED_USERS=

# Discord Bot Token (optional)
DISCORD_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 3. Home Assistant Integration
# ------------------------------------------------------------------------------
# URL of your Home Assistant instance (e.g. http://192.168.1.100:8123 or internal Docker network: http://homeassistant:8123)
HASS_URL=
# Long-lived access token generated from Home Assistant profile
HASS_TOKEN=
